# OCHAYOLI — Apache/LiteSpeed rules for Hostinger.
# Every block is wrapped in <IfModule> so a missing module degrades safely
# instead of returning a 500 for the whole site.

Options -Indexes
ErrorDocument 404 /404.html

# --- HTTPS -----------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Security headers ------------------------------------------------------
# The CSP matches the current site: same-origin scripts, styles, fonts and
# images only, no inline code. If you add a third-party embed (YouTube,
# Spotify, analytics) it must be allow-listed here first.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # --- Caching ---------------------------------------------------------------
  # CSS and JS filenames carry a content hash (see scripts/build.mjs), so they
  # can be cached for a year. Pages are always revalidated.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Hidden files ----------------------------------------------------------
<FilesMatch "^\.(?!htaccess$)">
  Require all denied
</FilesMatch>
